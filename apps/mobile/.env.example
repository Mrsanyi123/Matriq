# Copy to apps/mobile/.env and fill in. Both values are public (Row Level
# Security protects the data); never put the service-role key in the app.
# Leave them empty to build a demo-only app: the welcome screen then says
# accounts are not configured and offers only the demo.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: override the Android application ID (default com.matriq.app).
# MATRIQ_ANDROID_PACKAGE=
