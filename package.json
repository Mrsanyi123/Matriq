{
  "name": "matriq",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "db:test": "pnpm --filter @matriq/db test",
    "db:seed:generate": "pnpm --filter @matriq/db seed:generate"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
