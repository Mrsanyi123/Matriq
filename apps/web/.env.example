# Copy to .env.local and fill in. Both values are public (Row Level Security
# protects the data). Leave them empty to run the web app in demo-only mode:
# the welcome screen then explains that accounts are not configured and offers
# the on-device demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never put SUPABASE_SERVICE_ROLE_KEY or other secrets in this app.
